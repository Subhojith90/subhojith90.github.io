---
const apps = [
  {
    number: "01",
    initials: "QC",
    title: "Quanti Composer",
    label: "Quantum circuit composer",
    description: "Build, simulate and analyse quantum circuits through a visual Android interface, with Python script generation and circuit state visualisation.",
    detail: "100+ downloads · Education",
    link: "https://play.google.com/store/apps/details?id=com.quanti.composer"
  },
  {
    number: "02",
    initials: "ZX",
    title: "ZX Optimizer",
    label: "Diagrammatic circuit optimiser",
    description: "Generate ZX diagrams, apply rewrite rules and inspect circuit transformations from a lightweight mobile environment built for students and developers.",
    detail: "Android · Education",
    link: "https://play.google.com/store/apps/details?id=com.calculus.zxcalculusoptimizer"
  }
];
---
<section id="apps" class="section apps">
  <div class="shell">
    <p class="eyebrow">Released software</p>
    <div class="heading-row"><h2 class="section-title">Quantum tools,<br />built for Android.</h2><p>Two publicly released applications that take quantum circuit construction and ZX calculus beyond the desktop.</p></div>
    <div class="app-list">
      {apps.map((app) => (
        <article class="app-card">
          <div class="app-icon" aria-hidden="true"><span>{app.initials}</span></div>
          <div class="app-copy"><div class="meta"><span>{app.number}</span><span>{app.label}</span></div><h3>{app.title}</h3><p>{app.description}</p><small>{app.detail}</small></div>
          <a href={app.link} target="_blank" rel="noreferrer" aria-label={`View ${app.title} on Google Play`}><span class="play" aria-hidden="true">▶</span><span><small>Get it on</small>Google Play</span></a>
        </article>
      ))}
    </div>
  </div>
</section>
<style>
  .heading-row{display:flex;align-items:end;justify-content:space-between;gap:50px}.heading-row>p{max-width:420px;color:var(--ink-soft)}.app-list{margin-top:62px;border-top:1px solid var(--line)}.app-card{display:grid;grid-template-columns:112px minmax(0,1fr) 170px;gap:34px;align-items:center;padding:32px 0;border-bottom:1px solid var(--line)}.app-icon{width:96px;height:96px;display:grid;place-items:center;border:1px solid var(--line);border-radius:23px;background:var(--ink);box-shadow:0 12px 28px rgba(23,23,20,.13);color:#e7bd37;font-family:"Iowan Old Style",Georgia,serif;font-size:1.8rem}.meta{display:flex;gap:18px;color:var(--gold-deep);font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.67rem;text-transform:uppercase}.app-copy h3{margin-top:9px;font-family:"Iowan Old Style",Georgia,serif;font-size:2rem;font-weight:500;letter-spacing:-.03em}.app-copy>p{max-width:680px;margin-top:7px;color:var(--ink-soft);font-size:.87rem}.app-copy>small{display:block;margin-top:12px;color:var(--ink-soft);font-size:.66rem;font-weight:700;text-transform:uppercase}.app-card>a{display:flex;align-items:center;justify-content:center;gap:10px;padding:11px 14px;border:1px solid var(--ink);border-radius:10px;background:var(--ink);color:#fffdf7;text-decoration:none;transition:transform 180ms ease,background 180ms ease,color 180ms ease}.app-card>a:hover{transform:translateY(-2px);background:var(--gold);color:var(--ink)}.app-card>a>span:last-child{display:flex;flex-direction:column;font-size:.9rem;font-weight:700;line-height:1.12}.app-card>a small{font-size:.56rem;font-weight:500}.play{font-size:1.1rem}
  @media(max-width:800px){.heading-row{align-items:flex-start;flex-direction:column}.app-card{grid-template-columns:88px 1fr}.app-icon{width:76px;height:76px}.app-card>a{width:max-content;grid-column:2}}
  @media(max-width:520px){.app-card{grid-template-columns:1fr}.app-card>a{grid-column:1}.app-icon{width:68px;height:68px}}
</style>
